<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.nysm.NowYouSeeMe</id>
  <name>Now You See Me</name>
  <summary>See what your computer is doing, and why</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <developer id="io.github.sheheemmulakkal">
    <name>Muhammed Sheheem</name>
  </developer>
  <description>
    <p>
      A precise, lightweight resource monitor for engineers. It answers what is
      being used now, what changed in the last minutes, which process or
      container is responsible, and whether work is actually waiting on a
      resource.
    </p>
    <ul>
      <li>CPU per core, memory, swap, network, disks and filesystems, with pressure (PSI)</li>
      <li>Processes with real memory per app (PSS), select and watch, live details</li>
      <li>Containers, systemd services and apps against their limits</li>
      <li>Live values in the top bar, a terminal UI and a scriptable CLI</li>
      <li>Runs as a normal user, offline, with no account and no telemetry</li>
    </ul>
    <p>
      Values that cannot be measured are shown with the reason, never as a fake zero.
    </p>
  </description>
  <launchable type="desktop-id">dev.nysm.NowYouSeeMe.desktop</launchable>
  <icon type="stock">dev.nysm.NowYouSeeMe</icon>
  <url type="homepage">https://github.com/sheheemmulakkal/now-you-see-me</url>
